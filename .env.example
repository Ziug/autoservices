# Frontend: set for a connected Supabase project. Never put service-role keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=

# Super Admin hidden base path (obscurity only — real authorization is
# enforced server-side by the admin-api Edge Function; never rely on secrecy
# alone). Generate with `node scripts/generate-admin-path.mjs` and keep the
# real value out of git. Rotation = new value + rebuild + redeploy.
VITE_ADMIN_PATH=/control/admin

# Supabase Edge Function secrets (set with `supabase secrets set` or Dashboard).
# NOTE: custom secret names must NOT start with SUPABASE_ (platform-reserved).
# SUPABASE_URL is auto-provided to every function; APP_* keys hold your
# publishable (anon) JWT and secret (service_role) key values.
APP_ANON_KEY=
APP_SERVICE_ROLE_KEY=
BOOKING_TOKEN_SECRET=
APP_ALLOWED_ORIGINS=https://your-domain.example
APP_PUBLIC_URL=https://your-domain.example

# Optional assistant. Set rates at or above the selected model's current prices.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_DAILY_CALL_LIMIT=40
LLM_DAILY_TOKEN_LIMIT=300000
LLM_DAILY_COST_LIMIT_MICRO_USD=5000000
LLM_INPUT_MICRO_USD_PER_1K_TOKENS=20000
LLM_OUTPUT_MICRO_USD_PER_1K_TOKENS=80000

# Optional web push reminders. The public key is also VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
NOTIFICATION_CRON_SECRET=
